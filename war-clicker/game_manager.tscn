[node name="Label" type="Label" parent="UpgradeScreenGUI"]
layout_mode = 0
offset_left = 456.0
offset_top = 24.0
offset_right = 752.0
offset_bottom = 385.0
text = "Upgrades are a major WIP. Features shown here are subject to change. There are currently two types of upgrades, dynamic and permanent. Dynamic upgrades are on the left and can be refunded with the \"Reset Upgrades\" button. Permanent upgrades are on the right and cannot be refunded. 

Both kinds may or may not require prerequisities. Currently, only the \"Max Workers\" upgrades do, simply to demonstrate that it is possible."
autowrap_mode = 2


offset_top = 24.0
offset_right = 920.0
offset_bottom = 296.0
text = "Combat is still a major WIP.
For now, clicking the \"Raiding Party\" Button simply totals the number of units you have, subtracts that from 100 and rolls a d100. If your number is less than the die roll, you win the combat and recieve a random amount of captives based on a loot drop table.  Rarity of drops is Ranger < Scorpion < Hawk < Spider < Banshee < Farseer. Any and all of these mechanics are subject to change."
autowrap_mode = 1


[node name="Welcome" type="Label" parent="ManagementScreenGUI"]
unique_name_in_owner = true
visible = false
layout_mode = 0
offset_left = 273.0
offset_top = 83.0
offset_right = 1088.0
offset_bottom = 512.0
text = "Welcome to the Alpha Demo for HFE! Before you begin, take a moment to read through this preface about the game. 

Currently, it is a turn-based incremental game. You begin with a single Special Worker which can be assigned to produce specific units, as well as a resource called GP. 

With your units, you can engage in combat, providing captives who become Mass Workers. Mass Workers produce GP, as well as passively producing units at a random rate. 

Upgrades can be purchased to increase the amount of Mass Workers, the variety of units, number of units produced, likelyhood to produce multiple units from one production, and much, much more.

The \"End Turn\" Button above will calculate your GP based on your workers and move production forward.

Please keep in mind that this is all very, very much a work in progress. Many, many things are subject to change and are here simply as placeholders, proof of concept or prototype. I hope you enjoy fiddling with what I have so far! Press any of the buttons to your right to hide this message and begin the game."
autowrap_mode = 2

